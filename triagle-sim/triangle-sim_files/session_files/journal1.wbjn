# encoding: utf-8
# 2025 R2
SetScriptVersion(Version="25.2.172")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = template1.CreateSystem()
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit()
geometry1.Exit()
system1.Copy(KeepConnections=True)
system1.DisplayText = "3D geometry"
system2 = GetSystem(Name="SYS 1")
system2.DisplayText = "2D geometry"
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometry2.Edit()
geometry2.Exit()
system2.Delete()
system1.Copy(KeepConnections=True)
system3 = GetSystem(Name="SYS 1")
system3.DisplayText = "2D geometry"
geometry3 = system3.GetContainer(ComponentName="Geometry")
geometry3.Edit()
geometry3.Exit()
geometryProperties1 = geometry3.GetGeometryProperties()
geometryProperties1.GeometryImportAnalysisType = "AnalysisType_2D"
modelComponent1 = system3.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system3.GetContainer(ComponentName="Model")
model1.Edit()
Save(Overwrite=True)
Save(Overwrite=True)
Refresh()
Refresh()
model1.Edit()
model1.Exit()
system1.Copy(KeepConnections=True)
system4 = GetSystem(Name="SYS 2")
system4.DisplayText = "3D simu"
model2 = system4.GetContainer(ComponentName="Model")
model2.Edit()
model2.Edit()
Refresh()
model2.Exit()
Refresh()
model2.Edit()
Refresh()
model2.Exit()
system4.Delete()
Refresh()
system1.Copy(KeepConnections=True)
system5 = GetSystem(Name="SYS 2")
system5.DisplayText = "3D sim"
model3 = system5.GetContainer(ComponentName="Model")
model3.Edit()
model3.Exit()
Save(Overwrite=True)
